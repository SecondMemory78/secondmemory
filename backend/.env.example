# ШАБЛОН настроек. Скопировать в backend/.env и заполнить.
#
#   PowerShell:  copy .env.example .env
#
# В этом файле НЕТ и не должно быть настоящих значений — он лежит в репозитории,
# и всё, что здесь написано, видно всем. Настоящие ключи только в .env, который
# в git не попадает (см. .gitignore в корне).
#
# Блокнот любит сохранять файл как «.env.txt» — расширения в проводнике скрыты,
# и этого не видно. Приложение такой файл всё равно найдёт, но имя лучше
# поправить. BOM в начале файла (его тоже дописывает Блокнот) не мешает.
#
# Проверить, что настройки подхватились:  GET /api/health  →  поле ai.mode
# («боевой» = ключи видны, «демо» = работают заглушки).
#
# Ниже в скобках указано значение по умолчанию: если строку не заполнять,
# приложение возьмёт его. Помечено:
#   [разработка] — хватает для локального запуска
#   [БОЙ]        — без этого сервер в боевом режиме не стартует
#   [позже]      — понадобится, когда подключим соответствующий сервис


# ── ИИ: распознавание речи, фото и команды ─────────────────────────────────
# [разработка] stub = заглушки (фиксированный текст вместо распознавания),
# yandex = боевой режим, gigachat = альтернативный провайдер.
AI_PROVIDER=stub

# Yandex Cloud. Ключ создаётся для сервисного аккаунта в консоли облака.
# Ключ НЕ пересылать в мессенджеры и чаты — если переслали, создать новый,
# а старый удалить.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# (по умолчанию yandexgpt-lite) модель: yandexgpt-lite или yandexgpt
YANDEX_GPT_MODEL=

# [позже] альтернатива Яндексу
GIGACHAT_CREDENTIALS=

# Дневные лимиты на врача — страховка от неожиданного счёта.
# (по умолчанию: ocr 50, stt 50, llm 200 операций в день)
AI_LIMIT_OCR=
AI_LIMIT_STT=
AI_LIMIT_LLM=
# Прогнозная цена одной операции, руб. (по умолчанию: 0.15 / 0.35 / 0.50)
AI_PRICE_OCR=
AI_PRICE_STT=
AI_PRICE_LLM=
# (по умолчанию 2500) порог тревоги по расходам на врача в месяц, руб.
AI_COST_ALERT_RUB=


# ── Режим работы и доступ ──────────────────────────────────────────────────
# (по умолчанию 1) 1 = разработка: вход упрощён, код подтверждения виден
# в ответе API. 0 = БОЙ: демо-вход выключен, и сервер не стартует без
# ADMIN_TOKEN, FIELD_KEY, BLIND_INDEX_KEY и CORS_ORIGINS.
AUTH_OPTIONAL=1

# [БОЙ] токен админ-панели. Придумать длинный случайный, не «admin».
ADMIN_TOKEN=

# [БОЙ] адреса фронта через запятую, например https://vtoraya-pamyat.ru
# Пусто = кросс-доступ открыт всем.
CORS_ORIGINS=

# [позже] адрес фронта для ссылок в письмах и возврата после оплаты
FRONTEND_URL=

# (по умолчанию Europe/Moscow) часовой пояс по умолчанию; у врача свой в профиле
APP_TZ=Europe/Moscow

# (по умолчанию 1) фоновые задачи: напоминания, дайджесты, очередь распознавания
SCHEDULER_ENABLED=1


# ── Шифрование ─────────────────────────────────────────────────────────────
# ВНИМАНИЕ: сменить FIELD_KEY на базе с данными = данные больше не прочитать.
# Ключ заводится один раз до первых записей и хранится в надёжном месте
# (не в репозитории и не в чате). Приложение сверяет отпечаток ключа на старте.
# [БОЙ] ключ шифрования полей (ФИО, телефоны, содержимое заметок)
FIELD_KEY=
# [БОЙ] ключ «слепого индекса» — по нему ищем, не расшифровывая базу
BLIND_INDEX_KEY=
# (по умолчанию second-memory-dev-key) затравка для служебных значений
SECRET_SEED=


# ── База данных ────────────────────────────────────────────────────────────
# Пусто = SQLite в файле backend/second_memory.db (разработка).
# [БОЙ] PostgreSQL: postgresql+psycopg2://пользователь:пароль@хост:5432/имя_базы
# и зависимости ставятся из requirements-prod.txt.
DATABASE_URL=


# ── Ограничения запросов ───────────────────────────────────────────────────
# (по умолчанию 300 запросов за 60 секунд с адреса)
API_RATE_MAX=
API_RATE_WINDOW=
# (по умолчанию 10) попыток входа
AUTH_LOGIN_MAX=
# (по умолчанию 5) попыток ввода кода
AUTH_VERIFY_MAX=
# (по умолчанию 60) секунд между отправками кода — защита от «почтовой бомбы»
AUTH_CODE_COOLDOWN=
# (по умолчанию 15) кодов в сутки на адрес
AUTH_CODE_DAILY_MAX=
# (по умолчанию 15) максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=


# ── Почта ──────────────────────────────────────────────────────────────────
# [БОЙ] без неё на сервере никто не зарегистрируется: коды входа и ссылки
# восстановления пароля уходят письмом. Пусто = письма только в лог.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# адрес, куда падают обращения из поддержки
SUPPORT_EMAIL=


# ── Push-уведомления в браузере ────────────────────────────────────────────
# [позже] пара ключей VAPID генерируется один раз.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT_EMAIL=


# ── Оплата (ЮKassa) ────────────────────────────────────────────────────────
# [позже] пусто = в разработке подписка включается бесплатно, в бою это
# заблокировано.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# (по умолчанию 1) код ставки НДС для чека
YOOKASSA_VAT_CODE=


# ── Боты уведомлений ───────────────────────────────────────────────────────
# [позже]
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=


# ── Прочее ─────────────────────────────────────────────────────────────────
# [БОЙ] 1 = включить строгий HTTPS (HSTS). Включать только когда сайт
# уже работает по https, иначе можно закрыть себе доступ.
SECURE_HSTS=

# ── За обратным прокси (nginx) ─────────────────────────────────────────────
# [БОЙ] 1 = верить заголовку X-Forwarded-For от своего nginx. Без этого
# приложение видит адрес прокси вместо адреса посетителя, и лимит попыток
# входа считает всех одним клиентом. Включать ТОЛЬКО когда прямого доступа
# к приложению снаружи нет — иначе заголовок подделают.
TRUST_PROXY=0
# (по умолчанию 1) сколько своих прокси-слоёв стоит перед приложением
TRUST_PROXY_HOPS=1
